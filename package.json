{
  "name": "kud-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:project": "node scripts/check-project.mjs",
    "check:migrations": "node scripts/check-migration-ledger.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:smoke": "node scripts/run-e2e.mjs tests/e2e/public-smoke.spec.ts",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.mjs",
    "test:data:prepare": "node scripts/prepare-bulk-import-test-data.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
